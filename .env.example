# Copy to .env and fill in.
OPENAI_API_KEY=sk-...
# Optional: override the model (default gpt-4o for the agent; gpt-4o-mini for corpus/judge)
# SUPPORT_COPILOT_MODEL=gpt-4o

# Weaviate Cloud (for the RAG layer) — from your cluster's "Details" page
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=...
